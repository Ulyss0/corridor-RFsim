{
  "title": "CorridorWs",
  "description": "client: messages the front end sends; server: messages it receives.",
  "type": "object",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientMessage"
    },
    "server": {
      "$ref": "#/$defs/ServerMessage"
    }
  },
  "required": [
    "client",
    "server"
  ],
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ack",
          "default": "ack",
          "title": "Type",
          "type": "string"
        },
        "req_id": {
          "title": "Req Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "req_id"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Antenna": {
      "additionalProperties": false,
      "description": "Directional antenna, seen from above: a main beam with a hard edge, sidelobes elsewhere.\n\nThe cone is horizontal only: the planner is 2D plus time.",
      "properties": {
        "azimuth_deg": {
          "description": "Axis of the main beam, degrees clockwise from north.",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Azimuth Deg",
          "type": "number"
        },
        "beamwidth_deg": {
          "description": "Full width of the main beam.",
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Beamwidth Deg",
          "type": "number"
        },
        "sidelobe_db": {
          "description": "Gain outside the main beam, relative to the main beam (e.g. -20).",
          "maximum": 0,
          "title": "Sidelobe Db",
          "type": "number"
        }
      },
      "required": [
        "azimuth_deg",
        "beamwidth_deg",
        "sidelobe_db"
      ],
      "title": "Antenna",
      "type": "object"
    },
    "CancelCut": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cut.cancel",
          "default": "cut.cancel",
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "cut": {
          "title": "Cut",
          "type": "string"
        }
      },
      "required": [
        "type",
        "actor",
        "cut"
      ],
      "title": "CancelCut",
      "type": "object"
    },
    "ClientMessage": {
      "additionalProperties": false,
      "properties": {
        "req_id": {
          "title": "Req Id",
          "type": "string"
        },
        "command": {
          "discriminator": {
            "mapping": {
              "clock.set": "#/$defs/SetClock",
              "cut.cancel": "#/$defs/CancelCut",
              "cut.confirm": "#/$defs/ConfirmCut",
              "cut.schedule": "#/$defs/ScheduleCut",
              "inject.delay": "#/$defs/InjectDelay",
              "mission.launch": "#/$defs/LaunchMission"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ScheduleCut"
            },
            {
              "$ref": "#/$defs/CancelCut"
            },
            {
              "$ref": "#/$defs/ConfirmCut"
            },
            {
              "$ref": "#/$defs/LaunchMission"
            },
            {
              "$ref": "#/$defs/SetClock"
            },
            {
              "$ref": "#/$defs/InjectDelay"
            }
          ],
          "title": "Command"
        }
      },
      "required": [
        "req_id",
        "command"
      ],
      "title": "ClientMessage",
      "type": "object"
    },
    "ClockChanged": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "clock",
          "default": "clock",
          "title": "Type",
          "type": "string"
        },
        "clock": {
          "$ref": "#/$defs/ClockState"
        }
      },
      "required": [
        "type",
        "clock"
      ],
      "title": "ClockChanged",
      "type": "object"
    },
    "ClockState": {
      "additionalProperties": false,
      "properties": {
        "sim_time_s": {
          "title": "Sim Time S",
          "type": "number"
        },
        "factor": {
          "description": "Simulated seconds per wall-clock second.",
          "title": "Factor",
          "type": "number"
        },
        "paused": {
          "title": "Paused",
          "type": "boolean"
        }
      },
      "required": [
        "sim_time_s",
        "factor",
        "paused"
      ],
      "title": "ClockState",
      "type": "object"
    },
    "ConfirmCut": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cut.confirm",
          "default": "cut.confirm",
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "cut": {
          "title": "Cut",
          "type": "string"
        }
      },
      "required": [
        "type",
        "actor",
        "cut"
      ],
      "title": "ConfirmCut",
      "type": "object"
    },
    "Cut": {
      "additionalProperties": false,
      "description": "A window during which a friendly jammer is off.\n\nOnly a confirmed cut may be used by the planner for the approved route.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "jammer": {
          "title": "Jammer",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "status": {
          "enum": [
            "scheduled",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "requested_by": {
          "title": "Requested By",
          "type": "string"
        },
        "requested_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mission the cut was asked for; None: from the scenario.",
          "title": "Requested For"
        }
      },
      "required": [
        "id",
        "jammer",
        "start_s",
        "end_s",
        "status",
        "requested_by",
        "requested_for"
      ],
      "title": "Cut",
      "type": "object"
    },
    "CutCancelled": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cut.cancelled",
          "default": "cut.cancelled",
          "title": "Type",
          "type": "string"
        },
        "cut": {
          "$ref": "#/$defs/Cut",
          "description": "The cut as it was before cancellation."
        }
      },
      "required": [
        "type",
        "cut"
      ],
      "title": "CutCancelled",
      "type": "object"
    },
    "CutConfirmed": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cut.confirmed",
          "default": "cut.confirmed",
          "title": "Type",
          "type": "string"
        },
        "cut": {
          "$ref": "#/$defs/Cut"
        }
      },
      "required": [
        "type",
        "cut"
      ],
      "title": "CutConfirmed",
      "type": "object"
    },
    "CutScheduled": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cut.scheduled",
          "default": "cut.scheduled",
          "title": "Type",
          "type": "string"
        },
        "cut": {
          "$ref": "#/$defs/Cut"
        }
      },
      "required": [
        "type",
        "cut"
      ],
      "title": "CutScheduled",
      "type": "object"
    },
    "DroneState": {
      "additionalProperties": false,
      "description": "Simulated drone, every engine tick (about 2 Hz) while it flies.",
      "properties": {
        "type": {
          "const": "drone.state",
          "default": "drone.state",
          "title": "Type",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "action": {
          "enum": [
            "fly",
            "hover",
            "ground"
          ],
          "title": "Action",
          "type": "string"
        },
        "battery_used_pct": {
          "description": "Of battery_max_s, airborne time so far.",
          "title": "Battery Used Pct",
          "type": "number"
        },
        "delay_s": {
          "description": "Behind the schedule of the route being flown.",
          "title": "Delay S",
          "type": "number"
        },
        "revision": {
          "description": "Plan revision of the route being flown.",
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "mission",
        "position",
        "action",
        "battery_used_pct",
        "delay_s",
        "revision"
      ],
      "title": "DroneState",
      "type": "object"
    },
    "EnemyJammer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jammer",
          "default": "jammer",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/Position"
        },
        "eirp_w": {
          "description": "Estimated EIRP, watts.",
          "exclusiveMinimum": 0,
          "title": "Eirp W",
          "type": "number"
        },
        "bands": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bands",
          "type": "array"
        }
      },
      "required": [
        "type",
        "id",
        "pos",
        "eirp_w",
        "bands"
      ],
      "title": "EnemyJammer",
      "type": "object"
    },
    "EnemyRadar": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "radar",
          "default": "radar",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/Position"
        },
        "radius_m": {
          "description": "Estimated detection range.",
          "exclusiveMinimum": 0,
          "title": "Radius M",
          "type": "number"
        }
      },
      "required": [
        "type",
        "id",
        "pos",
        "radius_m"
      ],
      "title": "EnemyRadar",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "req_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when the message could not be parsed.",
          "title": "Req Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "req_id",
        "reason"
      ],
      "title": "Error",
      "type": "object"
    },
    "FriendlyJammer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "operator_callsign": {
          "title": "Operator Callsign",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/Position"
        },
        "eirp_w": {
          "description": "Effective isotropic radiated power, watts; in the main beam if `antenna`.",
          "exclusiveMinimum": 0,
          "title": "Eirp W",
          "type": "number"
        },
        "bands": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bands",
          "type": "array"
        },
        "antenna": {
          "anyOf": [
            {
              "$ref": "#/$defs/Antenna"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None: omnidirectional."
        },
        "cuts": {
          "items": {
            "$ref": "#/$defs/PlannedCut"
          },
          "title": "Cuts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "operator_callsign",
        "pos",
        "eirp_w",
        "bands",
        "antenna",
        "cuts"
      ],
      "title": "FriendlyJammer",
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/Position",
          "description": "South-west corner of the grid."
        },
        "cell_m": {
          "exclusiveMinimum": 0,
          "title": "Cell M",
          "type": "number"
        },
        "cols": {
          "exclusiveMinimum": 0,
          "title": "Cols",
          "type": "integer"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        }
      },
      "required": [
        "origin",
        "cell_m",
        "cols",
        "rows"
      ],
      "title": "Grid",
      "type": "object"
    },
    "InjectDelay": {
      "additionalProperties": false,
      "description": "Demo twist: hold the flying drone where it is for ``delay_s`` simulated seconds.",
      "properties": {
        "type": {
          "const": "inject.delay",
          "default": "inject.delay",
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "delay_s": {
          "exclusiveMinimum": 0,
          "maximum": 1800,
          "title": "Delay S",
          "type": "number"
        }
      },
      "required": [
        "type",
        "actor",
        "mission",
        "delay_s"
      ],
      "title": "InjectDelay",
      "type": "object"
    },
    "JammerRestarted": {
      "additionalProperties": false,
      "description": "A confirmed cut ended: the jammer is back on.",
      "properties": {
        "type": {
          "const": "jammer.restarted",
          "default": "jammer.restarted",
          "title": "Type",
          "type": "string"
        },
        "jammer": {
          "title": "Jammer",
          "type": "string"
        },
        "cut": {
          "title": "Cut",
          "type": "string"
        }
      },
      "required": [
        "type",
        "jammer",
        "cut"
      ],
      "title": "JammerRestarted",
      "type": "object"
    },
    "LaunchMission": {
      "additionalProperties": false,
      "description": "Only the mission pilot or the command post may launch.",
      "properties": {
        "type": {
          "const": "mission.launch",
          "default": "mission.launch",
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        }
      },
      "required": [
        "type",
        "actor",
        "mission"
      ],
      "title": "LaunchMission",
      "type": "object"
    },
    "Mission": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "drone_id": {
          "title": "Drone Id",
          "type": "string"
        },
        "pilot_callsign": {
          "description": "The pilot stands at the launch point.",
          "title": "Pilot Callsign",
          "type": "string"
        },
        "launch": {
          "$ref": "#/$defs/Position"
        },
        "target": {
          "$ref": "#/$defs/Position"
        },
        "band": {
          "title": "Band",
          "type": "string"
        },
        "link_eirp_w": {
          "description": "EIRP of the pilot's control link, watts.",
          "exclusiveMinimum": 0,
          "title": "Link Eirp W",
          "type": "number"
        },
        "cruise_speed_mps": {
          "exclusiveMinimum": 0,
          "title": "Cruise Speed Mps",
          "type": "number"
        },
        "battery_max_s": {
          "description": "Flight time on a full battery.",
          "exclusiveMinimum": 0,
          "title": "Battery Max S",
          "type": "number"
        },
        "departure_s": {
          "description": "Earliest departure.",
          "minimum": 0,
          "title": "Departure S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "drone_id",
        "pilot_callsign",
        "launch",
        "target",
        "band",
        "link_eirp_w",
        "cruise_speed_mps",
        "battery_max_s",
        "departure_s"
      ],
      "title": "Mission",
      "type": "object"
    },
    "MissionConstraints": {
      "additionalProperties": false,
      "description": "What constrains one mission: its grid, its zones, and the threats behind them.",
      "properties": {
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/Grid",
          "description": "Planning grid of the mission."
        },
        "zones": {
          "description": "Zones of the concerned threats, for this pilot.",
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "title": "Zones",
          "type": "array"
        },
        "jammers": {
          "description": "Friendly jammers that concern the mission.",
          "items": {
            "type": "string"
          },
          "title": "Jammers",
          "type": "array"
        },
        "threats": {
          "description": "Enemy threats that concern the mission.",
          "items": {
            "type": "string"
          },
          "title": "Threats",
          "type": "array"
        }
      },
      "required": [
        "mission",
        "grid",
        "zones",
        "jammers",
        "threats"
      ],
      "title": "MissionConstraints",
      "type": "object"
    },
    "MissionStatusChanged": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mission.status",
          "default": "mission.status",
          "title": "Type",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "flying",
            "arrived"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mission",
        "status"
      ],
      "title": "MissionStatusChanged",
      "type": "object"
    },
    "MissionView": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "$ref": "#/$defs/MissionConstraints",
          "description": "Grid, zones for this pilot, concerned jammers and threats."
        },
        "status": {
          "enum": [
            "planned",
            "flying",
            "arrived"
          ],
          "title": "Status",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanUpdated"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest plan; None until the first one."
        },
        "drone": {
          "anyOf": [
            {
              "$ref": "#/$defs/DroneState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest drone state; None before take-off."
        }
      },
      "required": [
        "constraints",
        "status",
        "plan",
        "drone"
      ],
      "title": "MissionView",
      "type": "object"
    },
    "Notification": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "notification",
          "default": "notification",
          "title": "Type",
          "type": "string"
        },
        "to": {
          "description": "Callsign of the pilot or of a jammer operator.",
          "title": "To",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NotificationAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "to",
        "text",
        "action"
      ],
      "title": "Notification",
      "type": "object"
    },
    "NotificationAction": {
      "additionalProperties": false,
      "description": "Command the recipient is expected to send back, shown as a button.",
      "properties": {
        "command": {
          "const": "cut.confirm",
          "title": "Command",
          "type": "string"
        },
        "cut": {
          "title": "Cut",
          "type": "string"
        }
      },
      "required": [
        "command",
        "cut"
      ],
      "title": "NotificationAction",
      "type": "object"
    },
    "PlanMetrics": {
      "additionalProperties": false,
      "properties": {
        "baseline_battery_used_pct": {
          "description": "Of battery_max_s.",
          "title": "Baseline Battery Used Pct",
          "type": "number"
        },
        "optimised_battery_used_pct": {
          "description": "Of battery_max_s.",
          "title": "Optimised Battery Used Pct",
          "type": "number"
        },
        "saved_pct": {
          "description": "Relative to the baseline consumption.",
          "title": "Saved Pct",
          "type": "number"
        },
        "saved_s": {
          "description": "Flight time saved, hover included, ground wait excluded.",
          "title": "Saved S",
          "type": "number"
        }
      },
      "required": [
        "baseline_battery_used_pct",
        "optimised_battery_used_pct",
        "saved_pct",
        "saved_s"
      ],
      "title": "PlanMetrics",
      "type": "object"
    },
    "PlanUpdated": {
      "additionalProperties": false,
      "description": "Planner output, after every change to the cuts while the mission is planned.",
      "properties": {
        "type": {
          "const": "plan.updated",
          "default": "plan.updated",
          "title": "Type",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "revision": {
          "description": "Grows by one per plan request of this mission.",
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "preview",
            "approved",
            "fallback",
            "baseline"
          ],
          "title": "Status",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/PlanMetrics"
        },
        "baseline_route": {
          "description": "As if every jammer stayed on.",
          "items": {
            "$ref": "#/$defs/RoutePoint"
          },
          "title": "Baseline Route",
          "type": "array"
        },
        "optimised_route": {
          "items": {
            "$ref": "#/$defs/RoutePoint"
          },
          "title": "Optimised Route",
          "type": "array"
        }
      },
      "required": [
        "type",
        "mission",
        "revision",
        "status",
        "metrics",
        "baseline_route",
        "optimised_route"
      ],
      "title": "PlanUpdated",
      "type": "object"
    },
    "PlannedCut": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
