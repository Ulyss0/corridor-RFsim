        "lat",
        "lon",
        "t",
        "action"
      ],
      "title": "RoutePoint",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "start_time": {
          "description": "Wall-clock time of simulated t = 0.",
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "js_threshold_db": {
          "description": "The control link is lost where J/S at the drone reaches this value.",
          "title": "Js Threshold Db",
          "type": "number"
        },
        "reference_link": {
          "$ref": "#/$defs/ReferenceLink"
        },
        "command_callsign": {
          "description": "Callsign of the command post, which sees all.",
          "title": "Command Callsign",
          "type": "string"
        },
        "friendly_jammers": {
          "items": {
            "$ref": "#/$defs/FriendlyJammer"
          },
          "title": "Friendly Jammers",
          "type": "array"
        },
        "enemy_threats": {
          "items": {
            "discriminator": {
              "mapping": {
                "jammer": "#/$defs/EnemyJammer",
                "radar": "#/$defs/EnemyRadar"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EnemyRadar"
              },
              {
                "$ref": "#/$defs/EnemyJammer"
              }
            ]
          },
          "title": "Enemy Threats",
          "type": "array"
        },
        "missions": {
          "items": {
            "$ref": "#/$defs/Mission"
          },
          "minItems": 1,
          "title": "Missions",
          "type": "array"
        }
      },
      "required": [
        "start_time",
        "js_threshold_db",
        "reference_link",
        "command_callsign",
        "friendly_jammers",
        "enemy_threats",
        "missions"
      ],
      "title": "Scenario",
      "type": "object"
