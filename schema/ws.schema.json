          },
          "title": "Cuts",
          "type": "array"
        }
      },
      "required": [
        "type",
        "viewer",
        "scenario",
        "nominal_zones",
        "missions",
        "clock",
        "cuts"
      ],
      "title": "Snapshot",
      "type": "object"
    },
