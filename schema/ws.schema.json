          "title": "Sim Time S",
          "type": "number"
        },
        "payload": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "clock": "#/$defs/ClockChanged",
                  "cut.cancelled": "#/$defs/CutCancelled",
                  "cut.confirmed": "#/$defs/CutConfirmed",
                  "cut.scheduled": "#/$defs/CutScheduled",
                  "drone.state": "#/$defs/DroneState",
                  "jammer.restarted": "#/$defs/JammerRestarted",
                  "mission.status": "#/$defs/MissionStatusChanged",
                  "notification": "#/$defs/Notification",
                  "plan.updated": "#/$defs/PlanUpdated"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CutScheduled"
                },
                {
                  "$ref": "#/$defs/CutCancelled"
                },
                {
                  "$ref": "#/$defs/CutConfirmed"
                },
                {
                  "$ref": "#/$defs/ClockChanged"
                },
                {
                  "$ref": "#/$defs/MissionStatusChanged"
                },
                {
                  "$ref": "#/$defs/Notification"
                },
                {
                  "$ref": "#/$defs/PlanUpdated"
                },
                {
                  "$ref": "#/$defs/DroneState"
                },
                {
                  "$ref": "#/$defs/JammerRestarted"
                }
              ]
            },
            {
              "discriminator": {
                "mapping": {
                  "ack": "#/$defs/Ack",
                  "error": "#/$defs/Error",
                  "snapshot": "#/$defs/Snapshot"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Snapshot"
                },
                {
                  "$ref": "#/$defs/Ack"
                },
                {
                  "$ref": "#/$defs/Error"
                }
              ]
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "seq",
        "sim_time_s",
        "payload"
      ],
      "title": "ServerMessage",
      "type": "object"
    },
