        "lat",
        "lon"
      ],
      "title": "Position",
      "type": "object"
    },
    "ReferenceLink": {
      "additionalProperties": false,
      "description": "Control link assumed for the nominal footprint of a jammer, seen without any mission.",
      "properties": {
        "eirp_w": {
          "description": "Link EIRP, watts.",
          "exclusiveMinimum": 0,
          "title": "Eirp W",
          "type": "number"
        },
        "range_m": {
          "description": "Distance from the drone to its pilot.",
          "exclusiveMinimum": 0,
          "title": "Range M",
          "type": "number"
        }
      },
