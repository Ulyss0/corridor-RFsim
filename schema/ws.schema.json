        "type",
        "actor",
        "jammer",
        "start_s",
        "end_s"
      ],
      "title": "ScheduleCut",
      "type": "object"
    },
    "ServerMessage": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "title": "Seq",
