        "range_m"
      ],
      "title": "ReferenceLink",
      "type": "object"
    },
    "RoutePoint": {
      "additionalProperties": false,
      "description": "Position at time ``t``; ``action`` holds until the next point.",
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "action": {
          "enum": [
            "fly",
            "hover",
            "ground"
          ],
          "title": "Action",
          "type": "string"
